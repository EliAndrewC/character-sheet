{
  "_comment": "ONE table of cases for the void-point draw order, run by BOTH tests/test_void_spend.py (app/services/void_spend.py: allocate_void_spend) and tests/js/shared_cases.test.js (roll_math.js: allocateVoidSpend). The rule has to exist on both sides - the sheet builds its spend menu without a round trip, and the Discord commands spend with no browser - so this file is what keeps them from drifting. Add a case here, never in only one suite.",
  "allocate": [
    {"name": "nothing asked for", "args": [0, 2, 3, 1], "want": {"fromTemp": 0, "fromRegular": 0, "fromWorldliness": 0, "allocated": 0, "short": false}},
    {"name": "temporary points go first", "args": [1, 2, 3, 1], "want": {"fromTemp": 1, "fromRegular": 0, "fromWorldliness": 0, "allocated": 1, "short": false}},
    {"name": "spills from temporary into regular", "args": [3, 2, 3, 1], "want": {"fromTemp": 2, "fromRegular": 1, "fromWorldliness": 0, "allocated": 3, "short": false}},
    {"name": "worldliness is the last resort", "args": [6, 2, 3, 1], "want": {"fromTemp": 2, "fromRegular": 3, "fromWorldliness": 1, "allocated": 6, "short": false}},
    {"name": "regular only", "args": [2, 0, 3, 0], "want": {"fromTemp": 0, "fromRegular": 2, "fromWorldliness": 0, "allocated": 2, "short": false}},
    {"name": "worldliness only", "args": [1, 0, 0, 2], "want": {"fromTemp": 0, "fromRegular": 0, "fromWorldliness": 1, "allocated": 1, "short": false}},
    {"name": "short when the pools run dry", "args": [7, 2, 3, 1], "want": {"fromTemp": 2, "fromRegular": 3, "fromWorldliness": 1, "allocated": 6, "short": true}},
    {"name": "short with nothing at all", "args": [1, 0, 0, 0], "want": {"fromTemp": 0, "fromRegular": 0, "fromWorldliness": 0, "allocated": 0, "short": true}},
    {"name": "negative pools count as empty", "args": [2, -1, 1, -3], "want": {"fromTemp": 0, "fromRegular": 1, "fromWorldliness": 0, "allocated": 1, "short": true}},
    {"name": "a negative request is no request", "args": [-2, 1, 1, 1], "want": {"fromTemp": 0, "fromRegular": 0, "fromWorldliness": 0, "allocated": 0, "short": false}}
  ],
  "dice_cap": [
    {"name": "under the cap is untouched", "args": [6, 3, 5], "want": {"rolled": 6, "kept": 3, "flat": 5, "overflow": 0}},
    {"name": "rolled past 10 becomes kept", "args": [12, 4, 0], "want": {"rolled": 10, "kept": 6, "flat": 0, "overflow": 0}},
    {"name": "kept past 10 becomes +2 each", "args": [10, 12, 1], "want": {"rolled": 10, "kept": 10, "flat": 5, "overflow": 4}},
    {"name": "both at once", "args": [13, 9, 0], "want": {"rolled": 10, "kept": 10, "flat": 4, "overflow": 4}}
  ]
}
